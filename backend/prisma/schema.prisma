// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STAFF)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile ClientProfile?
  staffProfile  StaffProfile?
  appointments  Appointment[]
  sales         Sale[]
  providedServices ServiceRecord[] @relation("ProvidedServices")
  serviceRecordsForClient ServiceRecord[] @relation("ClientServiceRecords")
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model ClientProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  notes     String?
  loyaltyPoints Int  @default(0)
}

model StaffProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  availability Availability[]
  services  Service[] // Services this staff can perform
  appointments Appointment[] // Appointments assigned to this staff
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal
  duration    Int      // in minutes
  isPublic    Boolean  @default(true)
  name_en     String?
  name_pt     String?
  name_uk     String?
  description_en String?
  description_pt String?
  description_uk String?
  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id])
  staff       StaffProfile[]
  appointments Appointment[]
  salesItems   SalesItem[]
}

model ServiceCategory {
  id       String    @id @default(uuid())
  name     String
  services Service[]
}

model Availability {
  id        String   @id @default(uuid())
  staffId   String
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0-6 (Sun-Sat)
  startTime String   // "09:00"
  endTime   String   // "17:00"
}

model Appointment {
  id        String   @id @default(uuid())
  clientId  String
  client    User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     StaffProfile? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  status    String   // PENDING, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  notes     String?
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal
  stock       Int      @default(0)
  sku         String?  @unique
  category    String?
  isPublic    Boolean  @default(true)
  name_en     String?
  name_pt     String?
  name_uk     String?
  description_en String?
  description_pt String?
  description_uk String?
  salesItems  SalesItem[]
}

model Sale {
  id        String   @id @default(uuid())
  clientId  String?
  client    User?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  total     Decimal
  createdAt DateTime @default(now())
  items     SalesItem[]
}

model ServiceRecord {
  id            String   @id @default(uuid())
  serviceName   String
  amount        Decimal
  serviceDate   DateTime @default(now())
  clientName    String
  paymentMethod String
  staffId       String
  staff         User     @relation("ProvidedServices", fields: [staffId], references: [id], onDelete: Cascade)
  clientId      String?
  client        User?    @relation("ClientServiceRecords", fields: [clientId], references: [id], onDelete: SetNull)
  // Regime of the job: "own" = own client + own material,
  // "studio" = studio client + studio material. Snapshot of the
  // percentage the worker keeps at the time of registration.
  rateScheme   String?
  keepPercent  Decimal? @db.Decimal(5, 2)
  createdAt    DateTime @default(now())
  // When this record comes from a paid CRM session, the session owns it:
  // deleting the session removes the earning with it.
  sessionId String?       @unique
  session   TattooSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SalesItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  quantity  Int
  price     Decimal
}
model GlobalSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Message {
  id        String   @id @default(uuid())
  content   String
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver  User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model News {
  id        String   @id @default(uuid())
  title     String
  content   String
  imageUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ CRM (clients & tattoo projects) ============

enum TattooSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum PhotoKind {
  DRAFT
  PROGRESS
  FINAL
}

model CrmClient {
  id        String          @id @default(uuid())
  name      String
  surname   String
  phone     String?
  email     String?
  country   String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  projects  TattooProject[]
}

model TattooProject {
  id              String          @id @default(uuid())
  clientId        String
  client          CrmClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceName     String?
  description     String?
  placement       String?
  size            String?
  cost            Decimal?
  plannedSessions Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sessions        TattooSession[]
  photos          ProjectPhoto[]
}

model TattooSession {
  id            String              @id @default(uuid())
  projectId     String
  project       TattooProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionNumber Int
  date          DateTime?
  status        TattooSessionStatus @default(IN_PROGRESS)
  notes         String?
  // Per-session payment: when the session is closed (COMPLETED) with a value,
  // that value is posted to the earnings ledger (ServiceRecord) and the link
  // is stored here. keepPercent snapshots the rate at payment time.
  amount        Decimal?            @db.Decimal(10, 2)
  paymentMethod String?
  keepPercent   Decimal?            @db.Decimal(5, 2)
  serviceRecord ServiceRecord?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  photos        ProjectPhoto[]

  @@unique([projectId, sessionNumber])
}

model ProjectPhoto {
  id        String        @id @default(uuid())
  projectId String
  project   TattooProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionId String?
  session   TattooSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  kind      PhotoKind     @default(PROGRESS)
  dataUrl   String        @db.Text
  createdAt DateTime      @default(now())
}
